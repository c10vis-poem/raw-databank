{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mem0RollingHabitsSchema",
  "description": "Schema for live episodic memory tracking of user habits, syntax preferences, and operational constraints across active agent sessions in #d.u.m.b.a.s.s.",
  "type": "object",
  "required": [
    "user_id",
    "updated_at",
    "syntax_habits",
    "naming_rules",
    "hardware_constraints",
    "architectural_laws"
  ],
  "properties": {
    "user_id": {
      "type": "string",
      "example": "operator"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "syntax_habits": {
      "type": "object",
      "properties": {
        "formatting_style": {
          "type": "string",
          "enum": ["markdown_standard", "plain_text", "jsonl_stream"],
          "default": "markdown_standard"
        },
        "conciseness_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Preference for dense, technical answers without conversational filler."
        },
        "verifiable_citations": {
          "type": "boolean",
          "default": true
        }
      },
      "required": ["formatting_style", "conciseness_score", "verifiable_citations"]
    },
    "naming_rules": {
      "type": "object",
      "properties": {
        "forbidden_terms": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Explicitly banned terms across all agent outputs."
        },
        "canonical_terms": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Mapping of system components to their exact canonical brand ligatures."
        }
      },
      "required": ["forbidden_terms", "canonical_terms"]
    },
    "hardware_constraints": {
      "type": "object",
      "properties": {
        "node_alpha": {
          "type": "object",
          "properties": {
            "device": { "type": "string" },
            "soc": { "type": "string" },
            "max_ram_mb": { "type": "integer" },
            "active_models": { "type": "array", "items": { "type": "string" } }
          }
        },
        "node_beta": {
          "type": "object",
          "properties": {
            "device": { "type": "string" },
            "soc": { "type": "string" },
            "max_ram_mb": { "type": "integer" },
            "active_services": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "architectural_laws": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": { "type": "string" },
          "statement": { "type": "string" },
          "severity": { "type": "string", "enum": ["HARD_INVARIANT", "STRICT_GUIDELINE"] }
        },
        "required": ["rule_id", "statement", "severity"]
      }
    }
  }
}
